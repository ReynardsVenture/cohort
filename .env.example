# Supabase (EU project)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram (first channel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Anthropic (ai-proxy only)
ANTHROPIC_API_KEY=

# Twilio (SMS — Phase 10)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp (Phase 12)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Twilio webhook URL (must match console config for signature validation)
TWILIO_WEBHOOK_URL=

# Stripe (Phase 8)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Ops (required in production — generate with openssl rand -hex 32)
COHORT_INTERNAL_SECRET=
COHORT_CRON_SECRET=
COHORT_PHONE_OTP_SALT=

# Local only: allow unauthenticated internal/cron functions during `supabase functions serve`
# COHORT_ALLOW_OPEN_INTERNAL=true
